---
import "../styles/global.css";
import { DATA_SOURCES, DISCLAIMERS, SITE, TOPICS } from "@ichiji/core";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  jsonLd?: unknown[];
  noindex?: boolean;
  /** 記事ページではモバイル下部ナビの「保存」を「目次」にする（5-1） */
  articleNav?: boolean;
  activeTopic?: string;
  activeSection?: string;
}

const { title, description = SITE.description, ogImage, ogType = "website", jsonLd = [], noindex = false, articleNav = false, activeTopic, activeSection } = Astro.props;
const fullTitle = title ? `${title}｜${SITE.name}` : `${SITE.name}｜${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.url.origin).toString();
const sections = [
  { href: "/articles/", label: "記事一覧", key: "articles" },
  { href: "/urgent/", label: "緊急（S・A）", key: "urgent" },
  { href: "/topics/", label: "トピック一覧", key: "topics" },
  { href: "/tags/", label: "タグ一覧", key: "tags" },
  { href: "/about/", label: "運営者情報", key: "about" },
];
const about = [
  { href: "/about/", label: "運営者情報" },
  { href: "/editorial-policy/", label: "エディトリアルポリシー" },
  { href: "/privacy/", label: "プライバシーポリシー" },
  { href: "/terms/", label: "利用規約" },
  { href: "/contact/", label: "お問い合わせ" },
  { href: "/rss.xml", label: "RSS" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.url.origin).toString()} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="theme-color" content="#0f2430" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />)}
  </head>
  <body>
    <a class="visually-hidden" href="#main">本文へスキップ</a>
    <div class="topbar">
      <div class="container">
        <span class="topbar__tagline">{SITE.tagline}　自社SaaSの開発チームのためのCVE一次対応メディア</span>
        <nav class="topbar__links" aria-label="会員メニュー" data-member-nav>
          <a href="/login/" data-guest>ログイン</a>
          <a href="/signup/" data-guest>会員登録</a>
          <a href="/app/" data-member hidden>ダッシュボード</a>
          <a href="/admin/" data-admin hidden>管理画面</a>
        </nav>
      </div>
    </div>
    <header class="header">
      <div class="container header__main">
        <a class="logo" href="/" aria-label={`${SITE.name} トップ`}>
          <span class="logo__mark" aria-hidden="true">一</span>
          <span class="logo__text">
            <span class="logo__name">{SITE.name}</span>
            <span class="logo__tagline">{SITE.tagline}</span>
          </span>
        </a>
        <nav class="sections-nav" aria-label="セクション">
          {sections.map((s) => <a href={s.href} aria-current={activeSection === s.key ? "page" : undefined}>{s.label}</a>)}
        </nav>
        <form class="search" action="/search/" method="get" role="search">
          <label class="visually-hidden" for="q">CVE・パッケージ名で検索</label>
          <input id="q" name="q" type="search" placeholder="CVE・パッケージ名で検索" />
          <button type="submit">検索</button>
        </form>
      </div>
      <nav class="topics-nav" aria-label="トピック">
        <ul>
          {
            TOPICS.map((t) => (
              <li>
                <a href={`/${t.key}/`} aria-current={activeTopic === t.key ? "page" : undefined}>
                  <small>{t.label}</small>
                  <span>{t.key === "os" ? "OS" : t.key === "line" ? "LINE SDK・LIFF" : t.name.replace(/（.*）/, "")}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" class="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer__grid">
          <div class="footer__brand">
            <a class="logo" href="/">
              <span class="logo__mark" aria-hidden="true">一</span>
              <span class="logo__text">
                <span class="logo__name">{SITE.name}</span>
                <span class="logo__tagline">{SITE.tagline}</span>
              </span>
            </a>
            <p class="footer__about">{SITE.description}</p>
          </div>
          <div>
            <h2>TOPICS</h2>
            <ul>{TOPICS.map((t) => <li><a href={`/${t.key}/`}>{t.name}</a></li>)}</ul>
          </div>
          <div>
            <h2>SECTIONS</h2>
            <ul>
              {sections.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
              <li><a href="/cve/">CVE DB</a></li>
              <li><a href="/saved/">保存した記事</a></li>
            </ul>
          </div>
          <div>
            <h2>ABOUT</h2>
            <ul>{about.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
          </div>
        </div>
        <p class="footer__disclaimer">{DISCLAIMERS.footer}</p>
        <p class="footer__credits">
          データ出典：{DATA_SOURCES.map((s, i) => <>{i > 0 && " ／ "}<a href={s.url} rel="noopener" target="_blank">{s.name}</a></>)}。
          This product uses the NVD API but is not endorsed or certified by the NVD.
        </p>
        <p class="footer__credits">© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>

    <nav class="mobile-nav" aria-label="モバイルナビ">
      <a href="/articles/">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h10" /></svg>
        記事一覧
      </a>
      <a href="/topics/">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1.5" /><rect x="13" y="4" width="7" height="7" rx="1.5" /><rect x="4" y="13" width="7" height="7" rx="1.5" /><rect x="13" y="13" width="7" height="7" rx="1.5" /></svg>
        トピック
      </a>
      <a href="/urgent/">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 2 20h20L12 3Z" /><path d="M12 10v4M12 17v.5" /></svg>
        緊急
      </a>
      {
        articleNav ? (
          <button type="button" data-toc-open>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" /></svg>
            目次
          </button>
        ) : (
          <a href="/saved/">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z" /></svg>
            保存
          </a>
        )
      }
    </nav>

    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
