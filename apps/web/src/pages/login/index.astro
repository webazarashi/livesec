---
import Base from "../../layouts/Base.astro";
---

<Base title="ログイン" noindex>
  <div class="container">
    <div class="card auth-box">
      <h1>ログイン</h1>
      <form class="form" data-login>
        <div class="field"><label for="email">メールアドレス</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="password">パスワード</label><input id="password" name="password" type="password" autocomplete="current-password" required /></div>
        <button class="btn btn--primary" type="submit">ログイン</button>
        <p class="form-status" role="status" data-status></p>
      </form>
      <form class="form" data-totp hidden>
        <p>認証アプリに表示されている6桁のコードを入力してください。</p>
        <div class="field"><label for="code">確認コード</label><input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required /></div>
        <label class="small"><input type="checkbox" name="trust" /> このブラウザを30日間信頼する</label>
        <button class="btn btn--primary" type="submit">確認する</button>
        <p class="small muted">認証アプリを使えない場合は <button type="button" class="btn btn--sm" data-backup>バックアップコードを使う</button></p>
        <p class="form-status" role="status" data-totp-status></p>
      </form>
      <p class="small">はじめての方は <a href="/signup/">会員登録</a></p>
    </div>
  </div>
</Base>

<script>
  import { api, errorMessage, safeNext, setStatus } from "../../scripts/forms";
  const next = safeNext(new URLSearchParams(location.search).get("next"));
  const login = document.querySelector<HTMLFormElement>("[data-login]")!;
  const totp = document.querySelector<HTMLFormElement>("[data-totp]")!;
  let useBackup = false;
  login.addEventListener("submit", async (e) => {
    e.preventDefault();
    const f = new FormData(login);
    setStatus(login.querySelector("[data-status]"), "確認しています…");
    const r = await api<{ twoFactorRedirect?: boolean }>("/api/auth/sign-in/email", { body: { email: f.get("email"), password: f.get("password") } });
    if (!r.ok) return setStatus(login.querySelector("[data-status]"), errorMessage(r.data), "error");
    if (r.data?.twoFactorRedirect) {
      login.hidden = true;
      totp.hidden = false;
      totp.querySelector("input")?.focus();
      return;
    }
    location.href = next;
  });
  totp.querySelector("[data-backup]")?.addEventListener("click", () => {
    useBackup = true;
    const input = totp.querySelector<HTMLInputElement>("input[name=code]")!;
    input.removeAttribute("pattern");
    input.removeAttribute("maxlength");
    input.inputMode = "text";
    totp.querySelector("label[for=code]")!.textContent = "バックアップコード";
  });
  totp.addEventListener("submit", async (e) => {
    e.preventDefault();
    const f = new FormData(totp);
    const url = useBackup ? "/api/auth/two-factor/verify-backup-code" : "/api/auth/two-factor/verify-totp";
    const r = await api(url, { body: { code: String(f.get("code") ?? "").trim(), trustDevice: f.get("trust") === "on" } });
    if (!r.ok) return setStatus(totp.querySelector("[data-totp-status]"), errorMessage(r.data), "error");
    location.href = next;
  });
</script>
